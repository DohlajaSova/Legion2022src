                <img class="clients__logo clients__logo--yandex" src="/assets/css/img/dev2b/logo_yandex_rus.svg" alt="">
                <img class="clients__logo clients__logo--five" src="/assets/css/img/dev2b/logo_5ka.svg" alt="">
                <img class="clients__logo clients__logo--auchan" src="/assets/css/img/dev2b/logo_auchan.svg" alt="">
                <img class="clients__logo clients__logo--burger" src="/assets/css/img/dev2b/logo_bking.svg" alt="">
                <img class="clients__logo clients__logo--medlinx" src="/assets/css/img/dev2b/logo_medlinx.svg" alt="">
                <img class="clients__logo clients__logo--peter-ned" src="/assets/css/img/dev2b/logo_peter_ned.svg" alt="">
                <img class="clients__logo clients__logo--globus" src="/assets/css/img/dev2b/logo_globus.svg" alt="">
                <img class="clients__logo clients__logo--docmed" src="/assets/css/img/dev2b/logo_docmed.svg" alt="">
                <img class="clients__logo clients__logo--zenit" src="/assets/css/img/dev2b/logo_zenit.svg" alt="">
