<div class="clients">
    <div class="clients__inner">
        <h2 class="clients__title">С&nbsp;2005 года помогаем цифровизировать ведущие отраслевые компании</h2>
        <a href="https://ratingruneta.ru/apps/" class="broadwise__item" target="_blank">
            <img class="clients__mark" src="/assets/css/img/dev2b/logo_rr.svg" alt="">
        </a>
    </div>

    <div class="clients__logos" aria-label="Клиенты">
        <div class="clients__logos-track">
            <div class="clients__logos-group">
                <img class="clients__logo clients__logo--sberbank" src="/assets/css/img/dev2b/logo_sberbank.svg" alt="Сбер Банк">
