                <img class="clients__logo clients__logo--yandex" src="/assets/css/img/dev2b/logo_yandex_rus.svg" alt="Яндекс">
                <img class="clients__logo clients__logo--five" src="/assets/css/img/dev2b/logo_5ka.svg" alt="Пятёрочка">
                <img class="clients__logo clients__logo--auchan" src="/assets/css/img/dev2b/logo_auchan.svg" alt="Ашан">
                <img class="clients__logo clients__logo--burger" src="/assets/css/img/dev2b/logo_bking.svg" alt="Burger King">
                <img class="clients__logo clients__logo--medlinx" src="/assets/css/img/dev2b/logo_medlinx.svg" alt="Medlinx">
                <img class="clients__logo clients__logo--peter-ned" src="/assets/css/img/dev2b/logo_peter_ned.svg" alt="Петербургская Недвижимость">
                <img class="clients__logo clients__logo--globus" src="/assets/css/img/dev2b/logo_globus.svg" alt="Глобус">
                <img class="clients__logo clients__logo--docmed" src="/assets/css/img/dev2b/logo_docmed.svg" alt="Docmed">
                <img class="clients__logo clients__logo--zenit" src="/assets/css/img/dev2b/logo_zenit.svg" alt="Зенит">
            </div>

            <div class="clients__logos-group" aria-hidden="true">
                <img class="clients__logo clients__logo--sberbank" src="/assets/css/img/dev2b/logo_sberbank.svg" alt="">
                <img class="clients__logo clients__logo--t2" src="/assets/css/img/dev2b/logo_t2.svg" alt="">
                <img class="clients__logo clients__logo--alfa" src="/assets/css/img/dev2b/logo_alfa.svg" alt="">
