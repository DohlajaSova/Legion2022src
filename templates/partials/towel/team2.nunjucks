<div class="team team_ver2 team_ver3">
    <div class="container">
        <div class="team__content">
            <h2>Команда e-legion</h2>
            <div class="team__content_text">
                <p>Наш главный ресурс&nbsp;— люди, которые стоят за&nbsp;каждым проектом.</p>
            </div>
        </div>
        <div class="team__slider js-team-container">
            <div class="team__list">
                <div class="team__list_item teammate">
                    <div class="teammate__container"><div class="teammate__contents">
                        <div class="teammate__photo"><img src="/assets/css/img/Team_Nikiforov_2025.webp" alt="Григорий Никифоров"></div>
                        <div class="teammate__body">
                            <div class="teammate__body_name">Григорий Никифоров</div>
                            <div class="teammate__body_position">руководитель проектного офиса</div>
                        </div>
                    </div></div>
                </div>
                <div class="team__list_item teammate">
                    <div class="teammate__container"><div class="teammate__contents">
                        <div class="teammate__photo"><img src="/assets/css/img/Team_Rizvanova_2025.webp" alt="Екатерина Ризванова"></div>
                        <div class="teammate__body">
                            <div class="teammate__body_name">Екатерина Ризванова</div>
                            <div class="teammate__body_position">руководитель отдела персонала</div>
                        </div>
                    </div></div>
                </div>
                <div class="team__list_item teammate">
                    <div class="teammate__container"><div class="teammate__contents">
                        <div class="teammate__photo"><img src="/assets/css/img/Team_Barannikov_2022.webp" alt="Михаил Баранников"></div>
                        <div class="teammate__body">
                            <div class="teammate__body_name">Михаил Баранников</div>
                            <div class="teammate__body_position">руководитель отдела мобильной разработки</div>
                        </div>
                    </div></div>
                </div>
                <div class="team__list_item teammate">
                    <div class="teammate__container"><div class="teammate__contents">
                        <div class="teammate__photo"><img src="/assets/css/img/Team_Denisova_2022.webp" alt="Елена Денисова"></div>
                        <div class="teammate__body">
                            <div class="teammate__body_name">Елена Денисова</div>
                            <div class="teammate__body_position">заместитель исполнительного директора</div>
                        </div>
                    </div></div>
                </div>
                <div class="team__list_item teammate">
                    <div class="teammate__container"><div class="teammate__contents">
                        <div class="teammate__photo"><img src="/assets/css/img/Team_Zherebtsov_2026.webp" alt="Никита Жеребцов"></div>
                        <div class="teammate__body">
                            <div class="teammate__body_name">Никита Жеребцов</div>
                            <div class="teammate__body_position">руководитель отдела дизайна</div>
                        </div>
                    </div></div>
                </div>
                <div class="team__list_item teammate">
                    <div class="teammate__container"><div class="teammate__contents">
                        <div class="teammate__photo"><img src="/assets/css/img/Team_Ievkov_2026.webp" alt="Игорь Иевков"></div>
                        <div class="teammate__body">
                            <div class="teammate__body_name">Игорь Иевков</div>
                            <div class="teammate__body_position">руководитель службы аккаунтинга</div>
                        </div>
                    </div></div>
                </div>
                <div class="team__list_item teammate">
                    <div class="teammate__container"><div class="teammate__contents">
                        <div class="teammate__photo"><img src="/assets/css/img/Team_Trapeznikov_2026.webp" alt="Сергей Трапезников"></div>
                        <div class="teammate__body">
                            <div class="teammate__body_name">Сергей Трапезников</div>
