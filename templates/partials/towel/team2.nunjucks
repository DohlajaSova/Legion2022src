                        </div>
                    </div></div>
                </div>
                <div class="team__list_item teammate">
                    <div class="teammate__container"><div class="teammate__contents">
                        <div class="teammate__photo"><img src="/assets/css/img/Team_Kim_2026.webp" alt="Ульяна Ким"></div>
