<!-- portfolio.nunjucks -->
{% extends "layout.nunjucks" %}
{% block title %} Портфолио - {% endblock %}
{% block links %} {% endblock %}
{% block content %}
<div class="redesign-portfolio">
    <div class="container">
        <h1 class="redesign-portfolio__header">Проекты и&nbsp;кейсы</h1>
        <p class="lead">Ставим в&nbsp;приоритет задачи бизнеса, но&nbsp;не&nbsp;забываем о&nbsp;пользователях наших клиентов. Ищем инициативы и&nbsp;помогаем отстраиваться от&nbsp;конкурентов.</p>
    </div>
    <div class="filter-tags-component__wrapper">
        <div class="tags">
            <div class="tags__container container">
                <div class="tags__categories js-tag-categories-container">
                    <div class="tags-category active" data-cats="all">
                        все проекты
                    </div>
                    <div class="tags-category" data-cats="development">
                        разработка
                    </div>
                    <div class="tags-category" data-cats="consulting">
                        консалтинг
                    </div>
                </div>
            </div>
            <div class="tags__container container">
                <div class="tags__selected">
                    <div class="tag-active hidden" data-filter-tag="fintech">
                        финтех
                    </div>
                    <div class="tag-active hidden" data-filter-tag="retail">
                        ритейл
                    </div>
                    <div class="tag-active hidden" data-filter-tag="real_estate">
                        недвижимость
                    </div>
                    <div class="tag-active hidden" data-filter-tag="telecom">
                        телеком
                    </div>
                    <div class="tag-active hidden" data-filter-tag="medtech">
                        медицина
                    </div>
                    <div class="tag-active hidden" data-filter-tag="edtech">
                        образование
                    </div>
                    <div class="tag-active hidden" data-filter-tag="IT">
                        ИТ
                    </div>
                    <div class="tag-active hidden" data-filter-tag="sports">
                        спорт
                    </div>
                    <div class="tag-active hidden" data-filter-tag="media">
                        медиа
                    </div>
                    <div class="tag-active hidden" data-filter-tag="other">
                        другое
                    </div>
                </div>
                <div id="tags-filters" class="tags-filters opacity-0 js-tag-filters-container">
                    <div class="tags-filters__container ">
                        <div class="filters-wrapper">
                            <div class="filter-tag" data-filter-tag="fintech">
                                финтех
                            </div>
                            <div class="filter-tag" data-filter-tag="retail">
                                ритейл
                            </div>
                            <div class="filter-tag" data-filter-tag="real_estate">
                                недвижимость
                            </div>
                            <div class="filter-tag" data-filter-tag="telecom">
                                телеком
                            </div>
                            <div class="filter-tag" data-filter-tag="medtech">
                                медицина
                            </div>
                            <div class="filter-tag" data-filter-tag="edtech">
                                образование
                            </div>
                            <div class="filter-tag" data-filter-tag="IT">
                                ИТ
                            </div>
                            <div class="filter-tag" data-filter-tag="sports">
                                спорт
                            </div>
                            <div class="filter-tag" data-filter-tag="media">
                                медиа
                            </div>
                            <div class="filter-tag" data-filter-tag="other">
                                другое
                            </div>
                            <div class="filter-tag filter-clear" data-filter-tag="clear">
                                сброс
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="redesign-portfolio__list redesign-portfolio__list_ver2 js-tag-publications">
            <a href="/[[~100]]" class="card" data-tag="telecom" data-cat="development">
                <span class="card__image"><span class="card__image-container">
                    <img src="/assets/css/img/portfolio/02-t2.webp" alt="" class="card__image-bg">
                    <span class="card__image-logo"><img src="/assets/css/img/portfolio/02-t2.svg" alt=""></span>
                </span></span>
                <span class="card__wrapper">
                    <span class="head">
                        Приложение федерального оператора t2
                    </span>
                    <span class="desc">
                        Запустили основной digital-канала коммуникации&nbsp;t2 (Tele2) с&nbsp;абонентами. Развили канала коммерциализации и&nbsp;апсейла продуктов оператора. Учавствовали в&nbsp;создании уникальных продуктов в&nbsp;телеком: Конструктор тарифов, Маркет Tele2, Центр управления&nbsp;ГБ, программа «Выгодно вместе». 
                    </span>
                    <span class="card-tags">
                        <span class="card-tags-tag">
                            телеком
                        </span>
                        <span class="card-tags-tag">
                            разработка
                        </span>
                    </span>
                </span>
            </a>
            <a href="/[[~107]]" class="card" data-tag="retail" data-cat="development">
                <span class="card__image"><span class="card__image-container">
                    <img src="/assets/css/img/portfolio/01-5ka.webp" alt="" class="card__image-bg">
                    <span class="card__image-logo"><img src="/assets/css/img/portfolio/01-5ka.svg" alt=""></span>
                </span></span>
                <span class="card__wrapper">
                    <span class="head">
                        Приложение торговой сети Пятёрочка
                    </span>
                    <span class="desc">
                        С&nbsp;2019&nbsp;года разрабатывали и&nbsp;развивали мобильное приложение «Пятёрочка». Сделали удобный сервис для совершения покупок с&nbsp;доставкой и&nbsp;программой лояльности. Внедрили уникальную функциональность для ритейла&nbsp;— «Шпионский клуб». Поддерживали непрерывную работу приложения, во&nbsp;время создания новой архитектуры и&nbsp;функциональностей. 
                    </span>
                    <span class="card-tags">
                        <span class="card-tags-tag">
                            ритейл
                        </span>
                        <span class="card-tags-tag">
                            разработка
                        </span>
                    </span>
                </span>
            </a>
            <a href="/[[~99]]" class="card" data-tag="edtech" data-cat="development">
                <span class="card__image"><span class="card__image-container">
                    <img src="/assets/css/img/portfolio/03-tbank.webp" alt="" class="card__image-bg">
                    <span class="card__image-logo"><img src="/assets/css/img/portfolio/03-tbank.svg" alt=""></span>
                </span></span>
                <span class="card__wrapper">
                    <span class="head">
                        Приложение Академия Инвестиций от&nbsp;Т-Банка
                    </span>
                    <span class="desc">
                        Сделали инвестирование доступным для каждого. Создали нативное мобильное приложение для iOS и&nbsp;Android на&nbsp;основе контента и&nbsp;логики работы веб-версии курсов, не&nbsp;имея исходных кодов.
                    </span>
                    <span class="card-tags">
                        <span class="card-tags-tag">
                            образование
                        </span>
                        <span class="card-tags-tag">
                            финтех
                        </span>
                        <span class="card-tags-tag">
                            разработка
                        </span>
                    </span>
                </span>
            </a>
            <a href="/[[~105]]" class="card" data-tag="fintech" data-cat="development">
                <span class="card__image"><span class="card__image-container">
                    <img src="/assets/css/img/portfolio/04-alfa.webp" alt="" class="card__image-bg">
                    <span class="card__image-logo"><img src="/assets/css/img/portfolio/04-alfa.svg" alt=""></span>
                </span></span>
                <span class="card__wrapper">
                    <span class="head">
                        Приложение для трейдинга Альфа-Инвестиции
                    </span>
                    <span class="desc">
                        Разработали мобильный инструмент для трейдинга и&nbsp;инвестирования от&nbsp;Альфа-Банка, который позволяет контролировать и&nbsp;управлять финансовыми активами в&nbsp;режиме реального времени.
                    </span>
                    <span class="card-tags">
                        <span class="card-tags-tag">
                            финтех
                        </span>
                        <span class="card-tags-tag">
                            разработка
                        </span>
                    </span>
                </span>
            </a>
            <a href="/[[~98]]" class="card" data-tag="real_estate" data-cat="development">
                <span class="card__image"><span class="card__image-container">
                    <img src="/assets/css/img/portfolio/05-pn.webp" alt="" class="card__image-bg">
                    <span class="card__image-logo"><img src="/assets/css/img/portfolio/05-pn.svg" alt=""></span>
                </span></span>
                <span class="card__wrapper">
                    <span class="head">
                        Приложение девелопера Петербургская Недвижимость
                    </span>
                    <span class="desc">
                        Разработали мобильное приложение для удобного поиска и&nbsp;бронирования квартир, включая варианты с&nbsp;ипотекой. Обновили дизайн и&nbsp;улучшили взаимодействие девелопера с&nbsp;клиентами. Запустили реферальную программу, чтобы помочь заказчику привлечь ещё больше клиентов.
                    </span>
                    <span class="card-tags">
                        <span class="card-tags-tag">
                            недвижимость
                        </span>
                        <span class="card-tags-tag">
                            разработка
                        </span>
