                <span class="card__image"><span class="card__image-container">
                    <img src="/assets/css/img/portfolio/06-osnova.webp" alt="" class="card__image-bg">
                    <span class="card__image-logo"><img src="/assets/css/img/portfolio/06-osnova.svg" alt=""></span>
